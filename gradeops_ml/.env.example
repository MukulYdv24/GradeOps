# ── LLM API Keys ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-...                   # GPT-4o for grading agent
# ANTHROPIC_API_KEY=...                 # Alternative: Claude

# ── Application ──────────────────────────────────────────────────
APP_ENV=development                     # development | production
SECRET_KEY=change-me-to-a-random-string-32chars
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Database (PostgreSQL) ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/gradeops

# ── Storage ──────────────────────────────────────────────────────
STORAGE_BACKEND=local                   # local | s3
LOCAL_STORAGE_PATH=./uploads

# AWS S3 (only if STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=gradeops-exams

# ── OCR Model ────────────────────────────────────────────────────
OCR_MODEL=Qwen/Qwen2-VL-7B-Instruct    # HuggingFace model ID
OCR_DEVICE=cuda                         # cuda | cpu | mps
OCR_MAX_NEW_TOKENS=2048

# ── Grading Agent ────────────────────────────────────────────────
GRADING_LLM_MODEL=gpt-4o               # LLM for grading decisions
GRADING_TEMPERATURE=0.1                 # Low = more deterministic
GRADING_MAX_TOKENS=1024

# ── Plagiarism ────────────────────────────────────────────────────
PLAGIARISM_SIMILARITY_THRESHOLD=0.88    # 0–1; flag if above this
EMBEDDING_MODEL=all-MiniLM-L6-v2       # Sentence-transformer model
